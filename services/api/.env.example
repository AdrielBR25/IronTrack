# Variáveis da API do IronTrack (Prompt 21). Copie para .env SÓ para desenvolvimento local; na Railway, configure no
# painel do serviço. NUNCA coloque valores reais neste arquivo nem em nenhum arquivo versionado.
# Descrição de cada uma em docs/NUVEM_IMPLANTACAO.md §4.

NODE_ENV=development
# PORT é definida pela Railway. Local: 8787.
PORT=8787
# Na Railway: referência ${{Postgres.DATABASE_URL}} (rede privada). Local: seu PostgreSQL de desenvolvimento.
DATABASE_URL=
# Origem pública do app (Netlify), usada nos links de e-mail e no CORS/CSRF.
APP_ORIGIN=http://localhost:5173
# Outras origens aceitas (vírgulas) e padrão de pré-visualizações da Netlify (opcional, começa com ^https://).
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_PATTERN=
# Segredo aleatório (32+ caracteres) para as chaves de limite de tentativas. Gere com: openssl rand -base64 48
RATE_LIMIT_SECRET=
# Só em desenvolvimento local sem HTTPS:
COOKIE_SECURE=false
# E-mail: disabled (padrão) | resend
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
# IA (chaves só aqui, nunca no app):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
