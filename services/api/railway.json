{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/api/Dockerfile",
    "watchPatterns": ["services/api/**", "services/ai-gateway/src/**", "shared/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "preDeployCommand": ["node services/api/scripts/migrate.ts"],
    "startCommand": "node services/api/src/main.ts",
    "healthcheckPath": "/api/v1/ready",
    "healthcheckTimeout": 120,
    "drainingSeconds": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
