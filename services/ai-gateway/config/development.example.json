{
  "$comment": "Exemplo de desenvolvimento SEM segredos. Copie para config/development.json (ignorado pelo git), gere uma credencial com `npm run gateway:token -- <id>` e cole o trecho em clients. As chaves dos provedores vêm só das variáveis de ambiente indicadas em apiKeyEnv. Os IDs de modelos são exemplos: confira na documentação oficial de cada provedor quais estão disponíveis e não descontinuados antes de habilitar.",
  "enabled": false,
  "host": "127.0.0.1",
  "port": 8787,
  "exposeBeyondLoopback": false,
  "allowedOrigins": ["http://localhost:5173", "http://localhost:4173"],
  "clients": [],
  "limits": {
    "maxBodyBytes": 65536,
    "maxMessages": 6,
    "maxInputChars": 24000,
    "maxOutputTokens": 1024,
    "requestsPerMinute": 10,
    "dailyTokenBudget": 50000,
    "maxConcurrentPerClient": 2,
    "maxConcurrentTotal": 8,
    "upstreamTimeoutMs": 30000,
    "maxUpstreamResponseBytes": 262144
  },
  "providers": {
    "openai": {
      "enabled": false,
      "displayName": "OpenAI",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": [{ "id": "SUBSTITUA-pelo-id-do-modelo", "displayName": "OpenAI (modelo escolhido)", "maxInputChars": 24000, "maxOutputTokens": 1024 }]
    },
    "anthropic": {
      "enabled": false,
      "displayName": "Anthropic Claude",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "apiVersion": "2026-10-21",
      "models": [{ "id": "claude-haiku-5-5", "displayName": "Claude Haiku 5.5", "maxInputChars": 24000, "maxOutputTokens": 1024 }]
    },
    "gemini": {
      "enabled": false,
      "displayName": "Google Gemini",
      "apiKeyEnv": "GEMINI_API_KEY",
      "models": [{ "id": "SUBSTITUA-pelo-id-do-modelo", "displayName": "Gemini (modelo escolhido)", "maxInputChars": 24000, "maxOutputTokens": 1024 }]
    }
  }
}
